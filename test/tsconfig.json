{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2018",
        "outDir": "../out/tmp",
        "rootDir": "..",
        "strict": true,
        "types": ["node"],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
		"useUnknownInCatchVariables": false,
    },
    "include": [
        "../src/BuildReport.ts",
        "../src/BuildStatistics.ts",
        "../src/ClangdConfig.ts",
        "../src/DotnetRuntime.ts",
        "../src/ExtensionInfo.ts",
        "../src/GccCallgraphParser.ts",
        "../src/GccStackUsageParser.ts",
        "../src/ProjectConfigReload.ts",
        "../src/core/**/*.ts",
        "scripts/**/*.ts"
    ]
}
